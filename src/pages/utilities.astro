---
import Layout from "../layouts/Layout.astro";
---

<Layout title="PickKali's Utilities" description="Kali's personal resource hub">
  <section class="section" style="display: grid; background-color: #242424;">
    <div id="cy" style="width: 98.5vw;  grid-area: 1 / -1;"></div>
    <div
      class="in-rows"
      style="grid-area: 1/-1; padding: 1rem; align-self: end; justify-self: end; gap: 0.5rem"
    >
      <button id="reset" class="purple slantR hoverwhite button slantbutton"
        >Reset Zoom</button
      >
      <a href="#MoreStuff">
        <button class="salmon slantR hoverwhite button slantbutton"
          >More Stuff!</button
        >
      </a>
    </div>
  </section>
  <script src="../scripts/nodeplan.js"></script>

  <section id="MoreStuff" class="halftone section">
    <div class="container">
      <h1>Various Assets!</h1>
      <div class="grid">
        <article class="kali-container">
          <h2>Palette</h2>
          <div style="text-align: center;">
            <div class="grid" style="margin-bottom: 1rem">
              <div class="tag" style="background-color: #FA8072;">#FA8072</div>
              <div class="tag" style="background-color: #14003D;">#14003D</div>
            </div>
            <div class="grid" style="margin-bottom: 1rem">
              <div class="tag" style="background-color: #000000;">#000000</div>
              <div class="tag" style="background-color: #242424;">#242424</div>
              <div class="tag" style="background-color: #3C3C3C;">#3C3C3C</div>
            </div>
            <div class="grid" style="margin-bottom: 1rem">
              <div
                class="tag"
                style="color: #000000; background-color: #798496;"
              >
                #798496
              </div>
              <div
                class="tag"
                style="color: #000000; background-color: #FFFFFF;"
              >
                #FFFFFF
              </div>
              <div
                class="tag"
                style="color: #000000; background-color: #FEEDD1;"
              >
                #FEEDD1
              </div>
            </div>
            <div class="grid" style="margin-bottom: 1rem">
              <div
                class="tag"
                style="color: #000000; background-color: #E9A3C2;"
              >
                #E9A3C2
              </div>
              <div
                class="tag"
                style="color: #000000; background-color: #E2BEFF;"
              >
                #E2BEFF
              </div>
              <div
                class="tag"
                style="color: #000000; background-color: #C871FF;"
              >
                #C871FF
              </div>
            </div>
            <div class="grid" style="margin-bottom: 1rem">
              <div
                class="tag"
                style="color: #000000; background-color: #FFF873;"
              >
                #FFF873
              </div>

              <div
                class="tag"
                style="color: #000000; background-color: #FFAA00;"
              >
                #FFAA00
              </div>
              <div
                class="tag"
                style="color: #000000; background-color: #FF5D60;"
              >
                #FF5D60
              </div>
            </div>
            <div class="grid" style="margin-bottom: 1rem">
              <div
                class="tag"
                style="color: #000000; background-color: #C7FFB6;"
              >
                #C7FFB6
              </div>
              <div
                class="tag"
                style="color: #000000; background-color: #37FF00;"
              >
                #37FF00
              </div>
              <div
                class="tag"
                style="color: #000000; background-color: #00CBFF;"
              >
                #00CBFF
              </div>
            </div>
          </div>
        </article>
        <article
          class="kali-container"
          style="align-content: center; text-align: center;"
        >
          <p
            class="kalico"
            style="font-size: 3rem; padding-block: 2rem; cursor: pointer; line-height: 2rem;"
          >
            <a href="/k/KalicoPolygon.otf">Kalico Polygon</a>
          </p>
          <p class="kalico">(It's my font) :3</p>
          <p class="kalico">Sphinx! Of black quartz, heed my vow?</p>
        </article>
      </div>
    </div>
  </section>
</Layout>

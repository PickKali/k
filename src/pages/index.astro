---
import Layout from "../layouts/Layout.astro";

import { Image } from "astro:assets";
import kalitrying from "../assets/index/kali-trying.png";
---

<Layout title="PickKali's Portfolio" description="And other, probably silly, things.">
  <section id="main-hero" class="kali-gradient section">
    <div id="main-content" class="container">
      <div class="centered">
        <Image
          id="tryingimage"
          src={kalitrying}
          alt="Drawing of Kali sitting down with headphones, looking at her laptop."
          height={450}
          width={450}
          title="Oh, there's a cursor on me. Hi cursor! ^w^"
          layout="constrained"
          draggable=false
        />
      </div>
      <div id="main-article">
        <article  class="halftone slantR bottomline">
          <header class="kalico bottomline" style="padding-left: 1.5rem;">
            <span style="font-size:2rem">PickKali / Kali Is Trying</span><br>
            small project enjoyer
          </header>
        </article>
      </div>
    </div>
  </section>
  <div class="container">
  </div>
  <style>
    #tryingimage {
      cursor: grab;
      filter: drop-shadow(-16px 16px var(--Dark));
    }
    #tryingimage:active {
      cursor: grabbing;
    }
    #main-hero {
      display: flex;
      flex-direction: column;
      justify-content: center;
      margin-inline: auto;
      padding-bottom: 4.5rem;
    }
    #main-content {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-evenly;
      gap: 1rem .5rem;
    }
    #main-article {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  </style>

  <script src="../scripts/index.js"></script>
</Layout>
